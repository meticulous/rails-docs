# Generated by `bin/rails export:site` — rebuilt with every export, so
# edit app/exporters/static_site/nginx.conf.erb instead.
#
# Everything is a file under root except the dynamic islands (diffs,
# search, legacy sdoc redirects, the ingest webhook), which proxy to the
# Rails app.

map $http_accept $static_site_suffix {
  default              "";
  "~*text/markdown"    ".md";
  "~*application/json" ".json";
}

map $http_x_forwarded_proto $static_site_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 80 default_server;
  server_name _;
  root <%= root %>;

  # A types block replaces the inherited table, so restate it first.
  include mime.types;
  types {
    text/markdown md;
  }
  charset utf-8;
  charset_types text/html text/plain text/xml text/css text/markdown text/javascript application/json application/javascript application/atom+xml image/svg+xml;

  gzip on;
  gzip_types text/plain text/xml text/css text/markdown text/javascript application/json application/javascript application/xml application/atom+xml image/svg+xml;

  absolute_redirect off;
  error_page 404 /404.html;
  error_page 500 502 503 504 /500.html;

  # /foo/ would otherwise hit the foo/ directory (no index) and 403.
  rewrite ^/(.+)/$ /$1 permanent;
<% if upstream -%>

<% if resolver -%>
  resolver <%= resolver %> valid=10s ipv6=off;
<% end -%>
  set $rails <%= upstream %>;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $static_site_proto;
<% end -%>

  location = / {
<% headers.each do |name, value| -%>
    add_header <%= name %> "<%= value %>" always;
<% end -%>
    add_header Cache-Control "public, max-age=3600";
    try_files /index.html =404;
  }

  location / {
<% headers.each do |name, value| -%>
    add_header <%= name %> "<%= value %>" always;
<% end -%>
    add_header Cache-Control "public, max-age=3600";
    add_header Vary Accept;
    try_files $uri$static_site_suffix $uri $uri.html $uri/index.html @miss;
  }

  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location ^~ /_nav/ {
<% headers.each do |name, value| -%>
    add_header <%= name %> "<%= value %>" always;
<% end -%>
    add_header Cache-Control "public, max-age=3600";
    try_files $uri.html =404;
  }

  location ^~ /feeds/ {
    add_header Cache-Control "public, max-age=3600";
    try_files $uri.atom =404;
  }

  location ~ "^/(?:[a-z0-9_-]+/)?(?:v[\d.]+|edge)/og/" {
    add_header Cache-Control "public, max-age=86400";
    try_files $uri.svg =404;
  }

  # Anything not on disk: version-less paths 302 to the same path under
  # the current stable (the long-lived link shape llms.txt advertises).
  # A miss under an explicit version goes to Rails, which renders the
  # "not in this version" page.
  location @miss {
<% ecosystem_segments.each do |slug, segment| -%>
    rewrite "^/<%= slug %>/(?!(?:v[\d.]+|edge)(?:/|$))(.+)$" /<%= slug %>/<%= segment %>/$1 redirect;
<% end -%>
    rewrite "^/(?!(?:[a-z0-9_-]+/)?(?:v[\d.]+|edge)(?:/|$))(.+)$" /<%= rails_segment %>/$1 redirect;
<% if upstream -%>
    proxy_pass $rails;
<% else -%>
    return 404;
<% end -%>
  }
<% if upstream -%>

  # Dynamic islands.
  location ~ "^/(?:[a-z0-9_-]+/)?(?:v[\d.]+|edge)/.+/-/diff/" {
    proxy_pass $rails;
  }

  location ~ ^/(?:search(?:/|$)|classes/|files/|_legacy_method$|webhooks/|up$) {
    proxy_pass $rails;
  }
<% end -%>
}
