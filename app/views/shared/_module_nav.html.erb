<%#
  The module-nav rail body: a collapsible namespace tree grouped by
  framework. Rendered inside a turbo-frame by NavController (see
  app/views/nav/show.html.erb), NOT inline in the layout — that keeps
  the 1,500-node tree out of every content page's HTML.

  No per-page active context here: the active-row highlight and
  default-expansion are applied client-side by the module-nav Stimulus
  controller from <meta name="nav:*"> tags, so this fragment caches as
  one blob per (source, channel, ingested_at).

  Locals: pv (PackageVersion);
          ecosystem_versions (ecosystem gems' current stables to append
          below the framework groups — empty unless the "Show ecosystem"
          box is ticked, which reloads the frame with ?ecosystem=1).
%>
<% ecosystem_versions = local_assigns.fetch(:ecosystem_versions, []) %>
<% rails_nav = pv.source.slug == "rails" %>
<%# <nav>, not <aside>: this is the site's primary API navigation, and
    an unlabeled complementary landmark hides that from the landmark
    list. CSS and the Stimulus controller are class/data-based, so the
    element swap changes nothing else. %>
<nav class="module-nav"
     aria-label="Modules and classes"
     data-controller="module-nav"
     data-module-nav-version-value="<%= version_url_segment(pv) %>">
  <div class="module-nav__header">
    <p class="module-nav__title">
      <%= pv.source.display_name %>
      <span class="muted">v<%= pv.channel %></span>
    </p>
    <input type="search"
           class="module-nav__filter"
           placeholder="Filter…"
           autocomplete="off"
           aria-label="Filter modules and classes"
           data-module-nav-target="filter"
           data-action="input->module-nav#filter">
    <% if rails_nav %>
      <label class="module-nav__ecosystem">
        <input type="checkbox"
               data-module-nav-target="ecosystem"
               data-action="change->module-nav#toggleEcosystem"
               <%= "checked" if ecosystem_versions.any? %>>
        Show ecosystem gems
      </label>
    <% end %>
  </div>

  <div class="module-nav__body" data-module-nav-target="list">
    <%# Bump the version token when the nav *markup* changes — the rest of
        the key (source, channel, ingested_at) only busts on re-ingest. %>
    <% cache [ "module-nav-grouped", "v3", pv.source.slug, pv.channel, pv.ingested_at&.to_i ] do %>
      <%
        rows = pv.source.entity_identities
          .where(kind: %w[class module])
          .joins(:entity_versions).where(entity_versions: { package_version_id: pv.id })
          .left_joins(:framework)
          .distinct
          .order("frameworks.display_name NULLS LAST", "entity_identities.fqn")
          .pluck("frameworks.slug", "frameworks.display_name", :fqn)
        grouped = rows.group_by { |slug, display, _| [ slug, display ] }
        version_segment = version_url_segment(pv)
        source_slug = rails_nav ? nil : pv.source.slug
      %>
      <% grouped.each do |(framework_slug, framework_display), framework_rows| %>
        <% group_label = framework_display || "Top-level" %>
        <% overview, nodes = module_nav_root_split(framework_rows.map { |_, _, fqn| fqn }) %>
        <details class="module-nav__group"
                 data-module-nav-target="group"
                 data-framework-slug="<%= framework_slug %>">
          <summary class="module-nav__group-summary">
            <span class="module-nav__group-name"><%= group_label %></span>
            <span class="module-nav__group-count muted"><%= framework_rows.size %></span>
          </summary>
          <ul class="module-nav__tree">
            <% if overview %>
              <li class="module-nav__node" data-fqn="<%= overview[:fqn].downcase %>">
                <div class="module-nav__row" data-depth="0">
                  <span class="module-nav__toggle-spacer"></span>
                  <%= link_to overview[:name],
                              entity_path(source_slug: source_slug, version: version_segment, path: EntityIdentity.fqn_to_url_path(overview[:fqn])),
                              class: "module-nav__link module-nav__link--overview", title: overview[:fqn] %>
                </div>
              </li>
            <% end %>
            <%= module_nav_tree(nodes, version_segment, depth: 0, source_slug: source_slug) %>
          </ul>
        </details>
      <% end %>
    <% end %>

    <%# Ecosystem gems, one group per source at that gem's own current
        stable (they version independently of Rails). Cached per gem so a
        turbo-rails re-ingest doesn't bust the whole strip. %>
    <% ecosystem_versions.each do |eco_pv| %>
      <% cache [ "module-nav-eco", "v1", eco_pv.source.slug, eco_pv.channel, eco_pv.ingested_at&.to_i ] do %>
        <%
          fqns = eco_pv.source.entity_identities
            .where(kind: %w[class module])
            .joins(:entity_versions).where(entity_versions: { package_version_id: eco_pv.id })
            .distinct
            .order(:fqn)
            .pluck(:fqn)
          overview, nodes = module_nav_root_split(fqns)
          eco_segment = version_url_segment(eco_pv)
        %>
        <details class="module-nav__group module-nav__group--ecosystem"
                 data-module-nav-target="group">
          <summary class="module-nav__group-summary">
            <span class="module-nav__group-name"><%= eco_pv.source.display_name %></span>
            <span class="module-nav__group-count muted">v<%= eco_pv.channel %> · <%= fqns.size %></span>
          </summary>
          <ul class="module-nav__tree">
            <% if overview %>
              <li class="module-nav__node" data-fqn="<%= overview[:fqn].downcase %>">
                <div class="module-nav__row" data-depth="0">
                  <span class="module-nav__toggle-spacer"></span>
                  <%= link_to overview[:name],
                              entity_path(source_slug: eco_pv.source.slug, version: eco_segment, path: EntityIdentity.fqn_to_url_path(overview[:fqn])),
                              class: "module-nav__link module-nav__link--overview", title: overview[:fqn] %>
                </div>
              </li>
            <% end %>
            <%= module_nav_tree(nodes, eco_segment, depth: 0, source_slug: eco_pv.source.slug) %>
          </ul>
        </details>
      <% end %>
    <% end %>
  </div>

  <p class="module-nav__empty muted" data-module-nav-target="empty" hidden>
    No matches.
  </p>
  <%# Live feedback for the filter — rows hiding/showing is silent for
      screen readers, and the "No matches." p toggling hidden doesn't
      announce reliably. Always present so role=status fires. %>
  <p class="visually-hidden" role="status" data-module-nav-target="status"></p>
</nav>
