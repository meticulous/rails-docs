<dialog class="palette shortcuts-help"
        aria-labelledby="shortcuts-help-label"
        data-action="click->keyboard#closeHelp keydown->keyboard#closeHelp">
  <div class="palette__inner shortcuts-help__inner" data-action="click->search-palette#stopPropagation">
    <h2 id="shortcuts-help-label" class="shortcuts-help__title">Keyboard shortcuts</h2>
    <dl class="shortcuts-help__list">
      <div class="shortcuts-help__row">
        <dt><kbd>/</kbd></dt>
        <dd>Focus search</dd>
      </div>
      <div class="shortcuts-help__row">
        <dt><kbd aria-label="Command K">⌘K</kbd> / <kbd>Ctrl-K</kbd></dt>
        <dd>Command palette</dd>
      </div>
      <div class="shortcuts-help__row">
        <dt><kbd>?</kbd></dt>
        <dd>This help</dd>
      </div>
      <div class="shortcuts-help__row">
        <dt><kbd>Esc</kbd></dt>
        <dd>Close</dd>
      </div>
    </dl>
    <%# WCAG 2.1.4 opt-out for the single-character shortcuts ("/", "?").
        ⌘K/Ctrl-K are modified combos and stay on; "?" keeps opening this
        dialog so the setting is always reachable. %>
    <label class="shortcuts-help__setting">
      <input type="checkbox" checked data-action="change->keyboard#toggleShortcuts">
      Enable single-key shortcuts (<kbd>/</kbd> and <kbd>?</kbd>)
    </label>
    <button type="button" class="shortcuts-help__close" data-action="click->keyboard#closeHelp">Close</button>
  </div>
</dialog>
