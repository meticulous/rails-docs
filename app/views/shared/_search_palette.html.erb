<dialog class="palette"
        aria-labelledby="palette-label"
        data-search-palette-target="dialog"
        data-action="click->search-palette#close keydown->search-palette#onKeydown">
  <div class="palette__inner" data-action="click->search-palette#stopPropagation">
    <label id="palette-label" for="palette-input" class="visually-hidden">Search Rails docs</label>
    <input type="search"
           id="palette-input"
           class="palette__input"
           placeholder="Search Rails docs"
           autocomplete="off"
           autocorrect="off"
           autocapitalize="off"
           spellcheck="false"
           role="combobox"
           aria-expanded="false"
           aria-autocomplete="list"
           aria-controls="palette-results"
           data-search-palette-target="input"
           data-action="input->search-palette#onInput keydown->search-palette#onKeydown">
    <ul id="palette-results" class="palette__results" data-search-palette-target="results" role="listbox" aria-label="Search results"></ul>
    <a class="palette__all" href="/search" data-search-palette-target="allLink" hidden>
      See all results →
    </a>
    <p class="palette__empty muted" data-search-palette-target="empty">
      Type at least 2 characters to search.
    </p>
    <%# Live status for screen readers: result counts don't announce
        themselves as the listbox re-renders. Always present in the DOM
        so role=status fires reliably. %>
    <p class="visually-hidden" role="status" data-search-palette-target="status"></p>
    <p class="palette__hint muted">
      <span aria-hidden="true"><kbd>↑↓</kbd> navigate · <kbd>↵</kbd> open · <kbd>esc</kbd> close</span>
      <span class="visually-hidden">Use the arrow keys to navigate results, Enter to open one, Escape to close.</span>
    </p>
  </div>
</dialog>
