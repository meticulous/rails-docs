<% content_for :title, @diff.title %>

<article class="diff">
  <header class="diff__header">
    <%= render "entities/breadcrumbs", identity: @identity, package_version: @to_version %>
    <h1 class="diff__name">
      <span class="entity__kind">diff</span>
      <%= @identity.fqn %>
    </h1>

    <div class="diff__switch" data-controller="diff-switcher">
      <span class="diff__switch-group">
        <label class="diff__switch-label" for="diff-base-version">Base</label>
        <select id="diff-base-version" data-action="change->diff-switcher#go">
          <% @diff.available_versions.reject { |v| v.id == @to_version.id }.each do |pv| %>
            <option value="<%= diff_path(version: version_url_segment(pv),
                                         entity_path: entity_url_path(@identity),
                                         other_version: version_url_segment(@to_version)) %>"
                    <%= "selected" if pv.id == @from_version.id %>>
              <%= version_label(pv) %>
            </option>
          <% end %>
        </select>
      </span>
      <span class="diff__switch-arrow" aria-hidden="true">→</span>
      <span class="diff__switch-group">
        <label class="diff__switch-label" for="diff-compare-version">Compare</label>
        <select id="diff-compare-version" data-action="change->diff-switcher#go">
          <% @diff.available_versions.reject { |v| v.id == @from_version.id }.each do |pv| %>
            <option value="<%= diff_path(version: version_url_segment(@from_version),
                                         entity_path: entity_url_path(@identity),
                                         other_version: version_url_segment(pv)) %>"
                    <%= "selected" if pv.id == @to_version.id %>>
              <%= version_diff_option_label(pv, changed: @diff.changed_version_ids.include?(pv.id)) %>
            </option>
          <% end %>
        </select>
      </span>
      <%= link_to "View #{version_label(@from_version)} without diff",
                  entity_path(version: version_url_segment(@from_version), path: entity_url_path(@identity)),
                  class: "diff__switch-plain" %>
    </div>
  </header>

  <% if @diff.added? %>
    <p class="diff__status diff__status--added">
      Added in <%= version_label(@to_version) %> — not present in <%= version_label(@from_version) %>.
    </p>
  <% elsif @diff.removed? %>
    <p class="diff__status diff__status--removed">
      Removed in <%= version_label(@to_version) %> — last seen in <%= version_label(@from_version) %>.
    </p>
  <% else %>
    <% unless @diff.signature_changed? || @diff.doc_changed? %>
      <p class="diff__status diff__status--unchanged">
        Signature and documentation are identical between
        <%= version_label(@from_version) %> and <%= version_label(@to_version) %>.
      </p>
    <% end %>

    <% if @diff.signature_changed? %>
      <section class="diff__section">
        <h2>Signature</h2>
        <%= render "diffs/lines", diff: @diff.signature_diff %>
      </section>
    <% end %>

    <% if @diff.doc_changed? %>
      <section class="diff__section">
        <h2>Documentation</h2>
        <%= render "diffs/lines", diff: @diff.doc_diff %>
      </section>
    <% end %>
  <% end %>
</article>
